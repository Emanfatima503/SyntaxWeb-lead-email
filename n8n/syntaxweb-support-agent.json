      "id": "a1f0c001-0000-4000-8000-000000000033",
      "name": "Create Ticket / Lead",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.5,
      "position": [
        1140,
        400
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Alert a SyntaxWeb team member immediately. Use when the customer is upset, asks for a human, reports a critical outage or security incident, or you could not help after two tries.",
        "sendTo": "info@syntaxweb.com",
        "subject": "🚨 SyntaxWeb support escalation",
        "emailType": "text",
        "message": "={{ $fromAI('summary', 'Who the customer is, their contact details if known, what they need, and why a human is required', 'string') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000034",
      "name": "Escalate to Human",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        1280,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.output, transcript: $('Normalize Voice').isExecuted ? $('Normalize Voice').item.json.transcript : '', session_id: $('Normalize Voice').isExecuted ? $('Normalize Voice').item.json.sessionId : $('Normalize Text').item.json.sessionId } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000040",
      "name": "Send Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1360,
        40
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: 'Sorry, I am having trouble right now. Please email info@syntaxweb.com or message us on WhatsApp at +92 300 1234567 and our team will help you.', transcript: '', session_id: '', error: true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000041",
