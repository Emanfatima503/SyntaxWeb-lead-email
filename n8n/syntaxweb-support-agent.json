    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Save a support ticket or a new project lead. Use type 'support' for problems from existing clients and 'lead' for new project enquiries. Only call this after you have the customer's name, email and a clear description. Returns the saved row including ticket_id.",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ticket_id": "={{ 'SW-' + $now.toFormat('yyMMdd-HHmmss') }}",
            "created_at": "={{ $now.toISO() }}",
            "type": "={{ $fromAI('type', 'Either support or lead', 'string') }}",
            "name": "={{ $fromAI('name', 'Customer full name', 'string') }}",
            "email": "={{ $fromAI('email', 'Customer email address', 'string') }}",
            "phone": "={{ $fromAI('phone', 'Customer phone number if given, otherwise empty', 'string') }}",
            "issue": "={{ $fromAI('issue', 'Clear summary of the problem or project request, including the service involved', 'string') }}",
            "urgency": "={{ $fromAI('urgency', 'One of: low, normal, high, critical. Use normal for leads', 'string') }}",
            "status": "open"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "ticket_id",
              "displayName": "ticket_id",
              "required": false,
